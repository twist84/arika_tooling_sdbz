  // Direct ELF-verified ID 1 (Warning) -> ID 2 (CRI Sofdec) calls.
  // A factory lookup and method invocation do NOT establish parent/child
  // ownership or a successful construction event.
  app_1 -> app_2 [style=dotted,color=darkcyan,label="lookup 0x003FABF8; direct 0x003FAC00"];
  app_1 -> app_2 [style=dotted,color=darkcyan,label="lookup 0x003FAC30; virtual +0x38 at 0x003FAC40"];

  // ID 28 result selector is a conditional native CHILD request, not a
  // guaranteed child construction. Default sentinel 0x30 creates no edge.
  app_28 -> app_29 [style=dashed,color=darkblue,label="0x0040BD0C selector=1; subcheck false"];
  app_28 -> app_30 [style=dashed,color=darkblue,label="0x0040BD0C selector=1; subcheck true"];
  app_28 -> app_34 [style=dashed,color=darkblue,label="0x0040BD0C selector=2"];
  app_28 -> app_38 [style=dashed,color=darkblue,label="0x0040BD0C selector=3"];

  // Sentinel 0x30 is not the 48th registered application.
  sentinel_48 [shape=diamond,label="0x30 sentinel (48), NOT an app"];
  request_input [shape=ellipse,label="Caller-supplied child ID"];
  current_child [shape=ellipse,label="Existing child instance"];
  request_input -> current_child [style=dashdot,color=darkorange,label="generic forward 0x003DFC1C, only if lookup succeeds"];

  // Exact generic successor mechanism, not a concrete ID 6 -> ID 3 edge.
  completed_child [shape=ellipse,label="Child phase 6"];
  parent_slot [shape=folder,label="Parent child-ID byte +0x12"];
  completed_child -> parent_slot [style=dashdot,color=darkblue,label="0x003DFF98 / 0x003DFFAC; successor from child +0x10"];
  parent_slot -> factory_lookup [style=dashdot,color=darkblue,label="0x003DFFC0; conditional lookup"];

  // ELF-backed field-derived native transitions; choice/exit flag gated.
  // These are requests, not successfully executed factories.
  app_6 -> app_3 [style=solid,color=darkblue,label="0x003E09E0; exit +0x2A = 3 (choice 1)"];
  app_6 -> app_6 [style=solid,color=darkblue,label="0x003E09E0; exit +0x2A = 6 (choice 3)"];

  // Factory lookup uses BSS ID-indexed table and jalr; it is not a direct
  // transition or proof that any particular constructor was executed.
  factory_lookup [shape=ellipse,label="lookup 0x003F1C40"];
  factory_table [shape=folder,label="BSS 0x006217E0 + 4*ID"];
  factory_lookup -> factory_table [style=dotted,color=darkgreen,label="indirect jalr at 0x003F1C78"];
  // Exact native ROOT handoff after phase-5 success. This differs from
  // lookup-only 0x3F1C40 and may actually invoke a factory via jalr.
  // These are static possible control-flow paths, not runtime observations.
  root_phase5 [shape=ellipse,label="Phase-5 completed, parent ID=0x30"];
  root_dispatch [shape=ellipse,label="root handoff 0x003F1BA0"];
  root_slot [shape=folder,label="active root pointer 0x0063BE38"];
  root_phase5 -> root_dispatch [style=solid,color=darkorange,label="call 0x003DFF34; pending ID +0x10"];
  root_dispatch -> factory_table [style=solid,color=darkorange,label="valid ID 1..47; indirect jalr 0x003F1BE0"];
  root_dispatch -> root_slot [style=solid,color=darkorange,label="store factory result or fallback at 0x003F1C04"];
  root_dispatch -> root_slot [style=dotted,color=gray,label="invalid ID => 0x005E1AC0 fallback at 0x003F1C30"];
}
